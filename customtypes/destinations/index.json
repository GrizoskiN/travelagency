{
  "format": "page",
  "id": "destinations",
  "label": "destination",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "continent": {
        "type": "Select",
        "config": {
          "label": "Continent",
          "placeholder": "",
          "options": [
            "Europe",
            "Asia",
            "South America",
            "North America",
            "Africa",
            "Australia"
          ]
        }
      },
      "country": {
        "type": "Text",
        "config": {
          "label": "Country",
          "placeholder": "France"
        }
      },
      "country_image": {
        "type": "Image",
        "config": {
          "label": "country_image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "meta_title",
          "placeholder": "Name of the place"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "meta_description",
          "placeholder": "Description"
        }
      },
      "start_date": {
        "type": "Date",
        "config": {
          "label": "Start Date",
          "placeholder": "Offer with fixed dates"
        }
      },
      "end_date": {
        "type": "Date",
        "config": {
          "label": "End Date",
          "placeholder": ""
        }
      },
      "destination_tag": {
        "type": "Group",
        "config": {
          "label": "Destination tag",
          "repeat": true,
          "fields": {
            "tags_link": {
              "type": "Link",
              "config": {
                "label": "Tags link",
                "select": "document",
                "customtypes": ["tags"]
              }
            }
          }
        }
      },
      "excerpt": {
        "type": "Text",
        "config": {
          "label": "Excerpt",
          "placeholder": "Short destination about the destination"
        }
      },
      "group_size": {
        "type": "Select",
        "config": {
          "label": "Group Size",
          "placeholder": "",
          "options": ["1-2", "2-4", "5+"]
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "destination_page": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO": {}
  }
}
